# Copy to .env.local for local development.
# On Vercel, set the same names in Project Settings → Environment Variables.
# Do not commit .env or .env.local. Do not put the service-role key in this app.

# Project URL from Supabase → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key. Use the anon key, or the newer publishable key if that is
# what the dashboard shows. Either value belongs in this variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional alias. Used only when NEXT_PUBLIC_SUPABASE_ANON_KEY is empty.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. Auth emails use this origin when it is set. Otherwise the app uses
# the request host (localhost in dev, the Vercel host in production).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
